<Window x:Class="RepairShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة ورشة الصيانة" Height="450" Width="350">
    <Grid Background="#F5F5F5">
        <StackPanel Margin="20">
            <TextBlock Text="إدارة ورشة الصيانة" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="نوع الجهاز:"/>
            <TextBox x:Name="TxtDevice" Margin="0,5,0,10" Padding="5"/>
            <TextBlock Text="سعر التصليح:"/>
            <TextBox x:Name="TxtPrice" Margin="0,5,0,15" Padding="5"/>
            <Button Content="توليد باركود" Click="BtnGenerate_Click" Background="#3498DB" Foreground="White" Padding="10"/>
            <Image x:Name="ImgBarcode" Margin="0,20,0,0" Height="100"/>
        </StackPanel>
    </Grid>
</Window>
